# Book Befikar — Apache config for GoDaddy hosting (static Next.js export)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Force HTTPS and www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.bookbefikar.com/$1 [L,R=301]

# Pages removed in the Spiti relaunch (301 so search rankings carry over)
RewriteRule ^itineraries/?$ /trips/ [L,R=301]
RewriteRule ^blog/?$ /journal/ [L,R=301]
RewriteRule ^destinations(/.*)?$ /spiti-valley/ [L,R=301]
RewriteRule ^styles(/.*)?$ /trips/ [L,R=301]
RewriteRule ^departures/?$ /trips/winter-spiti-christmas-new-year/ [L,R=301]
RewriteRule ^how-it-works/?$ /faq/ [L,R=301]
RewriteRule ^custom-trips/?$ /contact/ [L,R=301]
RewriteRule ^partners/?$ /contact/ [L,R=301]

# Add the trailing slash Next's export expects (/faq -> /faq/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

# Caching: hashed build assets forever, images a month, HTML always fresh
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType application/pdf "access plus 7 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^_next/static/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
